# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Large / binary artifacts (exceed GitHub's 100 MB limit; regenerable) ----
*.zip
*.npz
*.npy
*.pt
*.pth
*.ckpt
*.onnx
*.mp4
*.avi

# ---- Logs & scratch output (may embed local absolute paths) ----
*.log
*.out
*.tmp

# ---- Build bundle: regenerated by `python -m track2.make_kaggle_bundle`.
#      May contain un-scrubbed local Azure config — never commit. ----
kaggle_bundle/

# ---- Generated training outputs / logs that embed local absolute paths ----
HamiltonianNN/models/
HamiltonianNN/output2/

# ---- Local / cloud config & secrets (never commit) ----
.env
*.env
.envrc
.azure/
*.secret
*.pem
*.key

# ---- OS / editor ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
