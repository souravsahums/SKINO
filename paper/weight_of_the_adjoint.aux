\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Symplectic defect of every construction against \emph  {both} inner products, over $14$ grid configurations in $1$-D, $2$-D and $3$-D, mean of three seeds. The green diagonal is the result: each gradient shear is exact in the form its adjoint was built from and $O(1)$ in the other. The \textsc  {CKINO}{} kernel is $\approx 1.4$ in both---volume-preserving, not symplectic.}}{11}{figure.caption.20}\protected@file@percent }
\newlabel{fig:defect}{{5}{11}{Symplectic defect of every construction against \emph {both} inner products, over $14$ grid configurations in $1$-D, $2$-D and $3$-D, mean of three seeds. The green diagonal is the result: each gradient shear is exact in the form its adjoint was built from and $O(1)$ in the other. The \ckino {} kernel is $\approx 1.4$ in both---volume-preserving, not symplectic}{figure.caption.20}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.2}Does the choice of form matter?}{11}{subsection.7.2}\protected@file@percent }
