\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Rollout to $2\times 10^{4}$ steps, mean of 3 seeds. \textbf  {Top:} relative error; the thin line marks error $=$ signal. \textbf  {Bottom:} energy drift on the model's own trajectory. Every lifted or unstructured operator---FNO, SNO, \textsc  {CKINO}{}, and the lifted \textsc  {SA-Cheb}{} variants---leaves the solution manifold and reaches $10^{5}$--$10^{12}$. The lift-free operators stay bounded. The matched-form lift-free model (green) is bounded on all four problems; the mismatched-form one (red) survives three of four.}}{12}{figure.caption.23}\protected@file@percent }
\newlabel{fig:long}{{7}{12}{Rollout to $2\times 10^{4}$ steps, mean of 3 seeds. \textbf {Top:} relative error; the thin line marks error $=$ signal. \textbf {Bottom:} energy drift on the model's own trajectory. Every lifted or unstructured operator---FNO, SNO, \ckino {}, and the lifted \sacheb {} variants---leaves the solution manifold and reaches $10^{5}$--$10^{12}$. The lift-free operators stay bounded. The matched-form lift-free model (green) is bounded on all four problems; the mismatched-form one (red) survives three of four}{figure.caption.23}{}}
