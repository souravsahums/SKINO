\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textsc  {CKINO}{}. The kernel is stored as Chebyshev \emph  {coefficients} and evaluated on whatever CGL grid is requested, so the parameters are independent of resolution. The $(q,p)$ block mimics a St\"ormer--Verlet half-step. Its Jacobian is triangular with unit diagonal, hence volume-preserving---but, as \S  \ref {sec:form} shows by measurement, \emph  {not} symplectic in either candidate form.}}{6}{figure.caption.7}\protected@file@percent }
\newlabel{fig:ckino}{{2}{6}{\ckino {}. The kernel is stored as Chebyshev \emph {coefficients} and evaluated on whatever CGL grid is requested, so the parameters are independent of resolution. The $(q,p)$ block mimics a St\"ormer--Verlet half-step. Its Jacobian is triangular with unit diagonal, hence volume-preserving---but, as \S \ref {sec:form} shows by measurement, \emph {not} symplectic in either candidate form}{figure.caption.7}{}}
