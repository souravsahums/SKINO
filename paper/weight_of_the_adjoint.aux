\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Matched-form versus mismatched-form at identical capacity (3 seeds). \textbf  {(a)} Lifted pair: the matched-form model wins every problem, by $1.1$--$8.0\times $. \textbf  {(b)} Lift-free pair, where the deployed map really is symplectic: the margin widens to $14$--$22\times $. Removing the non-symplectic wrapper does not just help---it amplifies the effect of getting the form right by an order of magnitude.}}{11}{figure.caption.21}\protected@file@percent }
\newlabel{fig:ablation}{{6}{11}{Matched-form versus mismatched-form at identical capacity (3 seeds). \textbf {(a)} Lifted pair: the matched-form model wins every problem, by $1.1$--$8.0\times $. \textbf {(b)} Lift-free pair, where the deployed map really is symplectic: the margin widens to $14$--$22\times $. Removing the non-symplectic wrapper does not just help---it amplifies the effect of getting the form right by an order of magnitude}{figure.caption.21}{}}
